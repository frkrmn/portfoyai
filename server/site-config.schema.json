{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "template_id": {
      "type": "string",
      "enum": ["tm_01", "tm_02", "tm_03", "tm_04", "warm-editorial", "bold-luxury", "clean-modern", "neighborhood-friendly", "investment-focused", "urgent-deals", "guided-match", "land-plots"]
    },
    "business_name": {
      "type": "string"
    },
    "tone": {
      "type": "string"
    },
    "primary_color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "accent_color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "headline": {
      "type": "string"
    },
    "region_focus": {
      "type": "string"
    },
    "layout_fine_tune": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "buttonStyle": { "type": "string", "enum": ["solid", "outline", "pill", "sharp"] },
        "navAlignment": { "type": "string", "enum": ["left", "center", "split"] },
        "spacingDensity": { "type": "string", "enum": ["compact", "comfortable", "spacious"] },
        "cardStyle": { "type": "string", "enum": ["flat", "shadow", "bordered"] },
        "headingScale": { "type": "string", "enum": ["modest", "bold"] }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "neighborhoods": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["name", "description"]
          }
        },
        "feelings": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "type": "string" }
        },
        "timings": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "type": "string" }
        },
        "teamMembers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "bio": { "type": "string" },
              "photo_url": { "type": "string" }
            },
            "required": ["name", "role", "bio", "photo_url"]
          }
        },
        "services": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["title", "description"]
          }
        },
        "processSteps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["title", "description"]
          }
        }
      }
    }
  },
  "required": [
    "template_id",
    "business_name",
    "tone",
    "primary_color",
    "accent_color",
    "headline"
  ]
}
